build esp-idf/bootloader/CMakeFiles/encrypted-bootloader-flash | ${cmake_ninja_workdir}esp-idf/bootloader/CMakeFiles/encrypted-bootloader-flash: CUSTOM_COMMAND
  COMMAND = cd /home/piotr/Documents/Studia/praca_inzynierska/smart-medication-box/firmware/build/esp-idf/bootloader && /usr/bin/cmake -E echo "Error: The target encrypted-bootloader-flash requires" && /usr/bin/cmake -E echo "CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT to be enabled." && /usr/bin/cmake -E env "FAIL_MESSAGE=Failed executing target (see errors on lines above)" /usr/bin/cmake -P /home/piotr/esp/esp-idf/tools/cmake/scripts/fail.cmake

